# ===== API Keys =====
# Copy this file to .env and fill in your actual keys.
# NEVER commit .env to version control.

YOUTUBE_API_KEY=your_youtube_api_key_here
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=ToxicityDetectorBot/1.0

# ===== Phase 6A: JEV Contextual Decision Layer =====
JEV_ENABLED=true
GEMINI_API_KEY=
JEV_GEMINI_MODEL=gemini-3.6-flash
JEV_ENDPOINT_URL=
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=10.0

# ===== Server & Frontend Ports =====
API_HOST=127.0.0.1
API_PORT=8001
FRONTEND_PORT=3001
